{
  "name": "streamcaster",
  "private": true,
  "version": "0.1.0",
  "description": "Free cross-platform media casting + screen mirroring webapp",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:shared": "pnpm --filter @streamcaster/shared build",
    "build:sender": "pnpm --filter @streamcaster/sender build",
    "build:receiver": "pnpm --filter @streamcaster/receiver build",
    "build": "pnpm build:shared && pnpm build:receiver && pnpm build:sender",
    "build:site": "node scripts/build-site.mjs",
    "dev:sender": "pnpm --filter @streamcaster/sender dev",
    "dev:receiver": "pnpm --filter @streamcaster/receiver dev",
    "dev:signaling": "pnpm --filter @streamcaster/signaling dev",
    "dev:proxy": "pnpm --filter @streamcaster/proxy dev",
    "typecheck": "tsc -p packages/shared/tsconfig.json --noEmit && pnpm --filter @streamcaster/signaling typecheck && pnpm --filter @streamcaster/proxy typecheck",
    "test": "vitest run",
    "verify": "pnpm typecheck && pnpm test",
    "deploy:signaling": "pnpm --filter @streamcaster/signaling deploy",
    "deploy:proxy": "pnpm --filter @streamcaster/proxy deploy",
    "deploy:pages": "wrangler pages deploy site/dist --project-name streamcaster",
    "deploy:all": "pnpm build:site && pnpm deploy:signaling && pnpm deploy:proxy && pnpm deploy:pages"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "wrangler": "^3.85.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "workerd", "sharp"]
  }
}
